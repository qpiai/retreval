# LLM provider: gemini, openai, ollama, or vllm
LLM_PROVIDER=gemini

# Cloud providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Generation settings
MAX_OUTPUT_TOKENS=2048
TEMPERATURE=0.7

# ReTreVal tree / refinement settings
MAX_DEPTH=5                  # cap on tree depth (planner picks adaptively 1-5)
CHILDREN_PER_EXPANSION=3     # branching factor per node
REACT_MAX_STEPS=10           # max tool-augmented ReAct steps per node
MAX_LOOPS=2                  # outer refinement loops
MAX_FEEDBACK_LOOPS=1         # backtracking feedback iterations
LOCAL_SCORE_WEIGHT=0.6       # dual-scoring: local self-eval weight
CROSS_SCORE_WEIGHT=0.4       # dual-scoring: external critic weight
RECURSION_LIMIT=200          # LangGraph recursion limit

# Stop signal when the agent solves without the reference answer (the default):
# retry/backtracking fire only when best_score is below this.
SCORE_PASS_THRESHOLD=0.7

# Persistent cross-problem memory (insights/failures reused across runs).
# Path to the shared memory file; defaults to <repo>/memory.md when unset.
MEMORY_FILE=memory.md
